{
  "name": "elakrammen-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:electron": "tsc -p tsconfig.electron.json && node scripts/post-electron-build.js && concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron dist-electron/electron/main.js\"",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/post-electron-build.js && vite build && electron-builder --win",
    "build:dir": "tsc -p tsconfig.electron.json && node scripts/post-electron-build.js && vite build && electron-builder --win --dir",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^9.1.0"
  }
}
